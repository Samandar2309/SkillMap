# Django Configuration
DEBUG=True
DJANGO_SECRET_KEY=your-super-secret-key-here-min-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS & CSRF
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://yourdomain.com

# SSL & Security
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_USE_X_FORWARDED_PROTO=False

# Database
DATABASE_URL=sqlite:///db.sqlite3

# DRF Throttling Rates
DRF_THROTTLE_ANON=60/minute
DRF_THROTTLE_USER=120/minute
DRF_THROTTLE_AUTH=10/minute

# JWT Configuration
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=False
JWT_BLACKLIST_AFTER_ROTATION=False

# Email Configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@skillmap.local
FRONTEND_BASE_URL=http://localhost:8000

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

